.DS_Store
.env
__pycache__/
*.egg-info/
*.py[cod]
.pytest_cache/
.venv/
backend/.venv/
backend/data/
data/uploads/
data/outputs/
data/jobs/
data/inputs/
data/recovery/
data/models/
.idea/

# Rendered mask previews may contain the subject's private photo -- keep the
# generator, not the output. Regenerate with: python -m tools.build_edit_masks
evidence/*.png
evidence/**/*.png

# Local edit packages hold a copy of the subject's own photo and the masks
# derived from it; keep the generator (tools.build_local_edit_package), not the
# output. Regenerate with: python -m tools.build_local_edit_package --photo <img> --style <id>
artifacts/

# P2.9 audit: upstream CropAndStitch is GPL-3.0 while this repo is Apache-2.0,
# so the verbatim upstream source/README dumps stay local-only. Provenance and
# refetch commands live in evidence/p29-cropandstitch-audit/PROVENANCE.md.
evidence/p29-cropandstitch-audit/inpaint_cropandstitch.py
evidence/p29-cropandstitch-audit/upstream-README.md
evidence/p29-cropandstitch-audit/readme-api.json

# P2.9 RunningHub live check: raw third-party doc HTML dumps and the 32 MB
# /object_info catalogue stay local-only (fetched from runninghub.cn via the
# native ComfyUI proxy). Findings + refetch commands:
# evidence/p29-runninghub-live-audit.md
evidence/p29-runninghub-live/*.html
evidence/p29-runninghub-live/*.txt
evidence/p29-runninghub-live/*.json
evidence/p29-runninghub-live/*.py
# ...but keep the small derived node contract (factual API metadata).
!evidence/p29-runninghub-live/node-contract-cropandstitch.json

# P2.9 live ComfyUI probe: the 32 MB /object_info dump fetched from the GPU
# worker stays local-only. The findings it supports are written up in
# evidence/p29-runninghub-audit.md and evidence/p29-runninghub-live-audit.md.
evidence/p29-live-run/*.json

# P2.9 fix-run forensics: probe scripts, upstream source dumps and comparison
# renders all embed the subject's photo (or GPL upstream code). Findings are
# written up in evidence/p29-fix-run-report.md; keep only the derived stats.
evidence/p29-fix-run/*
!evidence/p29-fix-run/accept_stats.json

# P2.9 neck / hairline / collar revision: the before/after renders, the cached
# SCHP label map and the zoom crops all reproduce the subject's own photo, so
# they stay local-only. The write-up is evidence/p29-neck-fix-report.md; keep
# the derived stats and the offline probe scripts, which hold no image data.
evidence/p29-neck-fix/*
!evidence/p29-neck-fix/*.json
!evidence/p29-neck-fix/*.py
